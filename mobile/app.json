{
  "expo": {
    "name": "AI Caddie",
    "slug": "my-caiddie",
    "version": "1.1.2",
    "orientation": "portrait",
    "scheme": "ai-caddie",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D6A4F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cAIddie.aicaddie",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6A4F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-iap"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15ff3bf1-b636-412b-add6-830e1af3ee88"
      }
    },
    "owner": "banksharps-organization"
  }
}
